---
import type { MasFuertes } from "../data/types";

interface Props {
  data: MasFuertes;
}

const { data } = Astro.props;
---

<section id="mas-fuertes" class="seccion" aria-labelledby="mas-fuertes-titulo">
  <div class="bloque reveal">
    <p class="label-meta">solo nosotros</p>
    <h2 id="mas-fuertes-titulo">{data.titulo}</h2>
    <p class="bloque__texto">{data.texto}</p>
  </div>
</section>

<style>
  .bloque {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .bloque h2 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.4rem, 4vw + 1rem, 1.9rem);
    margin: var(--space-2) 0 var(--space-5);
    color: var(--color-ink);
  }

  .bloque__texto {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
</style>
