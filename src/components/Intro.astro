---
import type { Meta } from "../data/types";
import PilaPolaroids from "./PilaPolaroids.astro";

interface Props {
  meta: Meta;
}

const { meta } = Astro.props;
---

<section class="intro" aria-label="Portada">
  <p class="label-meta">para ti · <span id="hoy"></span></p>

  <PilaPolaroids />

  <h1>Hay algo que llevo semanas escribiendo.</h1>

  <p class="counter">
    Llevamos <strong id="dias-contador" data-inicio={meta.fecha_inicio_oficial}>&hellip;</strong> días juntos.
  </p>

  <a href="#como-empezo" class="entrar">
    <span class="entrar__circulo" aria-hidden="true">👾</span>
    <span class="label-meta">seguir bajando</span>
  </a>
</section>

<script>
  const hoyEl = document.getElementById("hoy");
  if (hoyEl) {
    hoyEl.textContent = new Intl.DateTimeFormat("es-ES", {
      day: "2-digit",
      month: "2-digit",
      year: "2-digit",
    }).format(new Date());
  }

  const contador = document.getElementById("dias-contador");
  const inicio = contador?.dataset.inicio;
  if (contador && inicio) {
    const inicioMs = new Date(`${inicio}T00:00:00`).getTime();
    const dias = Math.floor((Date.now() - inicioMs) / 86_400_000);
    contador.textContent = String(dias);
  }
</script>

<style>
  .intro {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    background:
      radial-gradient(60% 45% at 50% 12%, rgba(168, 66, 47, 0.14), transparent),
      var(--color-bg);
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.6rem, 5vw + 1rem, 2.4rem);
    line-height: 1.3;
    max-width: 18ch;
    color: var(--color-ink);
  }

  .counter {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink-soft);
  }

  .counter strong {
    color: var(--color-accent);
    font-weight: 500;
  }

  .entrar {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .entrar__circulo {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    line-height: 1;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-tertiary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .entrar__circulo {
      transition: transform 300ms var(--ease-paper);
    }

    .entrar:hover .entrar__circulo {
      transform: scale(1.06);
    }
  }
</style>
